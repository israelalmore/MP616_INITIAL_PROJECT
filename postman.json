    {
      "name": "Create nurse - 201 Created",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Nurse\",\n  \"username\": \"{{createUsername}}\",\n  \"password\": \"postman-pass\",\n  \"email\": \"{{createEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/nurse",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "nurse"
          ]
        },
        "description": "Creates a temporary nurse with a unique username and email and stores its id in the created_nurse_id collection variable. The update and delete requests below work on this nurse, so the collection never modifies existing data. Required JSON fields: name, username, password, email; profileImage and status are optional. Expected statuses: 201 Created, 400 Bad Request for invalid data or duplicate username/email."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('created_nurse_id');",
              "const runId = Date.now();",
              "pm.variables.set('createUsername', 'postman-' + runId);",
              "pm.variables.set('createEmail', 'postman-' + runId + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('returns the new nurse without a password field', function () {",
              "    const nurse = pm.response.json();",
              "    pm.expect(nurse.id).to.be.a('number');",
              "    pm.expect(nurse.username).to.equal(pm.variables.get('createUsername'));",
              "    pm.expect(nurse.status).to.equal('active');",
              "    pm.expect(nurse).not.to.have.property('password');",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('created_nurse_id', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "201 Created",
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
