    {
      "name": "Update nurse - 200 OK",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Nurse\",\n  \"username\": \"{{updateUsername}}\",\n  \"email\": \"{{updateEmail}}\",\n  \"status\": \"active\",\n  \"profileImage\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/nurse/{{nurse_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "nurse",
            "{{nurse_id}}"
          ]
        },
        "description": "Updates the nurse identified by nurse_id. Required JSON fields: name, username, email, and status; profileImage and password are optional. Expected statuses: 200 OK, 400 Bad Request for invalid data or duplicate username/email, and 404 Not Found for an unknown ID. This request changes data in the selected environment."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now();",
              "pm.variables.set('updateUsername', 'postman-' + runId);",
              "pm.variables.set('updateEmail', 'postman-' + runId + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('does not expose the password', function () {",
              "    pm.expect(pm.response.json()).not.to.have.property('password');",
              "});"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
