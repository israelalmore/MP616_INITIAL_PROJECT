{
  "info": {
    "_postman_id": "6780e0a6-99fa-43d5-a013-2332588dbd66",
    "name": "Nurse API",
    "description": "Requests for the Symfony Nurse API. Set base_url to the server root. The search route is /nurse/name/{name}, but the current backend matches that value against an exact username. The update request changes the selected nurse.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "nurse_id",
      "value": "1"
    },
    {
      "key": "missing_nurse_id",
      "value": "999999999"
    },
    {
      "key": "search_name",
      "value": "nurse1"
    },
    {
      "key": "login_username",
      "value": "nurse1"
    },
    {
      "key": "login_password",
      "value": "n1pass"
    }
  ],
  "item": [
    {
      "name": "Login - 200 OK",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{login_username}}\",\n  \"password\": \"{{login_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/nurse/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "nurse",
            "login"
          ]
        },
        "description": "Authenticates a nurse. JSON body fields: username (string) and password (string). Returns 200 for valid credentials and 401 for invalid or missing credentials. Demo defaults are nurse1 / n1pass; use only with local development data."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('confirms successful authentication', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('success', true);",
              "    pm.expect(body).to.have.property('message');",
              "});"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"success\": true,\n  \"message\": \"Credenciales correctas\"\n}"
        }
      ]
    },
    {
      "name": "Login - 401 Unauthorized",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{login_username}}\",\n  \"password\": \"incorrect-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/nurse/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "nurse",
            "login"
          ]
        },
        "description": "Demonstrates the invalid-credentials response. Expected status: 401 Unauthorized."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('returns the authentication error message', function () {",
              "    pm.expect(pm.response.json()).to.have.property('success', false);",
              "});"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "401 Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"success\": false,\n  \"message\": \"Credenciales incorrectas\"\n}"
        }
      ]
    },
    {
      "name": "Get all nurses - 200 OK",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/nurse/index",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "nurse",
            "index"
          ]
        },
        "description": "Returns all nurses as a JSON array, ordered by ID. No request body or parameters are required. Expected status: 200 OK. Passwords are not included."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('returns an array without password fields', function () {",
              "    const nurses = pm.response.json();",
              "    pm.expect(nurses).to.be.an('array');",
              "    nurses.forEach(function (nurse) {",
              "        pm.expect(nurse).not.to.have.property('password');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "[\n  {\n    \"id\": 1,\n    \"name\": \"Ana Garcia\",\n    \"username\": \"nurse1\",\n    \"createdAt\": \"2026-10-20 09:00:00\",\n    \"updatedAt\": \"2026-10-20 09:00:00\",\n    \"profileImage\": null,\n    \"email\": \"ana.garcia@example.com\",\n    \"status\": \"active\"\n  }\n]"
        }
      ]
    },
    {
      "name": "Search nurse by name - 200 OK",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/nurse/name/{{search_name}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "nurse",
            "name",
            "{{search_name}}"
          ]
        },
        "description": "Path parameter: search_name. Expected status: 200 when a nurse is found, or 404 when not found. Note: despite the route parameter being named 'name', the current Symfony controller uses this value as an exact username (for example, nurse1); it does not search the display-name field."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('returns a nurse without a password field', function () {",
              "    const nurse = pm.response.json();",
              "    pm.expect(nurse).to.have.property('id');",
              "    pm.expect(nurse).to.have.property('name');",
              "    pm.expect(nurse).not.to.have.property('password');",
              "});"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
